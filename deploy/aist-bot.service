# systemd unit for the AIST bot.
#
#   sudo cp deploy/aist-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aist-bot
#
# Logs:  journalctl -u aist-bot -f

[Unit]
Description=AIST school feedback Telegram bot
Documentation=https://github.com/Abdurayim/aist-bot
After=network-online.target
Wants=network-online.target

# Never give up restarting. The school's connection to Telegram is not
# always reachable, and the default limit of five starts in ten seconds
# would otherwise leave the bot stopped until someone noticed.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
# notify, not simple: the bot reports when it has actually finished
# starting, and feeds a watchdog afterwards. A process that is alive but
# wedged looks perfectly healthy to Restart=always; the watchdog is what
# notices it and replaces it.
Type=notify
NotifyAccess=main

# If the bot stops reporting for this long, systemd kills and restarts it.
WatchdogSec=120

# The bot retries a slow link to Telegram before giving up, which can take
# over a minute. Leave room for that rather than killing it mid-retry.
TimeoutStartSec=180
TimeoutStopSec=30

User=aistbot
Group=aistbot

WorkingDirectory=/opt/aist-bot
ExecStart=/opt/aist-bot/bin/aist-bot

# The bot reads .env from its working directory, and writes the SQLite
# database there too.

# Telegram connections drop; the bot should simply come back.
# (The start-rate limit is lifted in [Unit] above, which is where systemd
# reads those two settings from.)
Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aist-bot

# ── Surviving a server under memory pressure ─────────────────────────
# When another project on this box exhausts the RAM, the kernel picks a
# victim by score. The bot is tiny — a few megabytes — so killing it frees
# almost nothing while silencing the school's only channel for complaints.
# Make it a far less attractive target than whatever is actually at fault.
OOMScoreAdjust=-500

# If it is killed anyway, treat that as a failure so Restart=always brings
# it back rather than leaving the unit stopped.
OOMPolicy=stop

# ── Hardening ────────────────────────────────────────────────────────
# The bot needs its own directory and outbound HTTPS, nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# The one directory it may write to.
ReadWritePaths=/opt/aist-bot

[Install]
WantedBy=multi-user.target
