# systemd unit for the AIST bot.
#
#   sudo cp deploy/aist-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aist-bot
#
# Logs:  journalctl -u aist-bot -f

[Unit]
Description=AIST school feedback Telegram bot
Documentation=https://github.com/Abdurayim/aist-bot
After=network-online.target
Wants=network-online.target

# Never give up restarting. The school's connection to Telegram is not
# always reachable, and the default limit of five starts in ten seconds
# would otherwise leave the bot stopped until someone noticed.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

User=aistbot
Group=aistbot

WorkingDirectory=/opt/aist-bot
ExecStart=/opt/aist-bot/bin/aist-bot

# The bot reads .env from its working directory, and writes the SQLite
# database there too.

# Telegram connections drop; the bot should simply come back.
# (The start-rate limit is lifted in [Unit] above, which is where systemd
# reads those two settings from.)
Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aist-bot

# ── Hardening ────────────────────────────────────────────────────────
# The bot needs its own directory and outbound HTTPS, nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# The one directory it may write to.
ReadWritePaths=/opt/aist-bot

[Install]
WantedBy=multi-user.target
