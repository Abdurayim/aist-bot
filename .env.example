# ─────────────────────────────────────────────────────────────
#  AIST BOT — configuration
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
BOT_TOKEN=

# Admin phone numbers, comma separated.
# Any number of admins is allowed (3, 4 or more), and one person
# may list several of their own numbers — each number is a separate entry.
# Format: +998XXXXXXXXX
ADMIN_PHONES=+998901112233,+998935556677,+998977778899,+998901234567

# SQLite database file
DB_PATH=./aist_bot.db

# Leave WEBHOOK_URL empty to run in polling mode (recommended for local use).
# Set it to your public https URL (e.g. https://bot.example.uz) for webhook mode.
WEBHOOK_URL=

# HTTP port used only in webhook mode
SERVER_PORT=8083

# Organisation name printed in the PDF header
ORG_NAME=AIST School
